PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pixell
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d
STORAGE_URL=http://localhost:5000/media
CORS_ORIGIN=http://localhost:5173
TMDB_READ_ACCESS_TOKEN=your_tmdb_read_access_token_here
VIDEASY_BASE_URL=https://player.videasy.ws/embed

# ==========================================
# 🔥 Firebase Backend Configuration (Option B)
# ==========================================
# Set to 'true' to use Firebase Cloud Firestore as primary database
USE_FIREBASE=false
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Paste private key with \n or place serviceAccountKey.json in /server or root
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgI...\n-----END PRIVATE KEY-----\n"
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# Optional Firebase Realtime Database URL
FIREBASE_DATABASE_URL=https://your-firebase-project-id-default-rtdb.firebaseio.com

# ==========================================
# ⚡ Firebase Client Configuration (Admin Live Radar Real-Time)
# ==========================================
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-firebase-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

